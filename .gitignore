# Les trois modeles intermediaires restent hors du depot.
models/*
!models/best_model.keras

# Images uploadees par les utilisateurs de l'API
app/static/uploads/

# metrics/ est volontairement versionne : 520 Ko de graphiques et de
# metriques qui documentent les resultats publies dans le README.

